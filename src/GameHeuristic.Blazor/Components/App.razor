@using GameHeuristic.Core
@using System.Timers
@using Microsoft.AspNetCore.Components.Web
@rendermode @(Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer)

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Connect 4 Heuristic Framework - Web UI</title>
    <HeadOutlet />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            display: flex;
            flex-direction: row;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 25px;
            gap: 30px;
            max-width: 1000px;
            width: 100%;
        }

        .board-container {
            background-color: #2b579a;
            padding: 15px;
            border-radius: 12px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            grid-gap: 10px;
            flex: 1;
        }

        .cell {
            width: 60px;
            height: 60px;
            background-color: white;
            border-radius: 50%;
            border: 1.5px solid #222;
            box-shadow: 0 4px 6px rgba(0,0,0,0.15);
            transition: background-color 0.2s ease;
        }

        .cell.red { background-color: #ff3333; }
        .cell.yellow { background-color: #ffcc00; }

        .control-panel {
            width: 250px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        h2 { margin-top: 0; font-size: 22px; border-bottom: 2px solid rgba(255,255,255,0.2); padding-bottom: 10px; }

        label { font-size: 14px; font-weight: 500; }

        select, input[type="range"] {
            width: 100%;
            padding: 8px;
            border-radius: 6px;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 14px;
        }

        select option {
            background-color: #1e3c72;
            color: white;
        }

        button {
            padding: 12px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 15px;
            transition: all 0.2s ease;
        }

        .btn-start { background-color: #4caf50; color: white; }
        .btn-start:hover:not(:disabled) { background-color: #45a049; }
        .btn-start:disabled { background-color: #888; cursor: not-allowed; }

        .btn-reset { background-color: #e7e7e7; color: black; }
        .btn-reset:hover { background-color: #d4d4d4; }

        .status-text {
            background: rgba(0, 0, 0, 0.2);
            padding: 12px;
            border-radius: 6px;
            text-align: center;
            font-weight: bold;
            font-size: 14px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 1. Interactive Connect 4 Grid -->
        <div class="board-container">
            @for (int r = 0; r < Board.Rows; r++)
            {
                @for (int c = 0; c < Board.Columns; c++)
                {
                    int row = r;
                    int col = c;
                    Player piece = _board.GetPiece(row, col);
                    string cellClass = piece switch
                    {
                        Player.Red => "cell red",
                        Player.Yellow => "cell yellow",
                        _ => "cell"
                    };
                    <div class="@cellClass"></div>
                }
            }
        </div>

        <!-- 2. Sidebar Controls -->
        <div class="control-panel">
            <h2>Match Settings</h2>

            <label>Player 1 (Red):</label>
            <select @bind="_player1Name">
                @foreach (var h in _heuristics)
                {
                    <option value="@h.Name">@h.Name</option>
                }
            </select>

            <label>Player 2 (Yellow):</label>
            <select @bind="_player2Name">
                @foreach (var h in _heuristics)
                {
                    <option value="@h.Name">@h.Name</option>
                }
            </select>

            <label>Move Delay: @(_delayMs) ms</label>
            <input type="range" min="50" max="2000" step="50" @bind="_delayMs" />

            <button class="btn-start" disabled="@_isPlaying" @onclick="StartMatch">Start Match</button>
            <button class="btn-reset" @onclick="ResetMatch">Reset</button>

            <div class="status-text">
                @_status
            </div>
        </div>
    </div>
</body>
</html>

@code {
    // Core Game Fields
    private Board _board = new Board();
    private List<IHeuristic> _heuristics = new List<IHeuristic>();
    private string _player1Name = "";
    private string _player2Name = "";
    private int _delayMs = 500;
    private bool _isPlaying = false;
    private string _status = "Select players and start";

    // Timer Event Loop
    private Timer? _gameTimer;
    private MinimaxAI? _ai1;
    private MinimaxAI? _ai2;
    private Player _currentPlayer;

    protected override void OnInitialized()
    {
        // 1. Load heuristics dynamically
        _heuristics = HeuristicLoader.LoadHeuristics();
        if (_heuristics.Count > 0)
        {
            _player1Name = _heuristics[0].Name;
            _player2Name = _heuristics[Math.Min(1, _heuristics.Count - 1)].Name;
        }
    }

    #region Timer-based Game Loop (Web Standard)

    private void StartMatch()
    {
        if (_isPlaying) return;

        _board = new Board();
        _isPlaying = true;

        IHeuristic h1 = _heuristics.First(h => h.Name == _player1Name);
        IHeuristic h2 = _heuristics.First(h => h.Name == _player2Name);

        _ai1 = new MinimaxAI(h1, depth: 6);
        _ai2 = new MinimaxAI(h2, depth: 6);
        _currentPlayer = Player.Red;

        _status = "Red's turn...";

        // Set up the system timer
        _gameTimer = new Timer(_delayMs);
        _gameTimer.Elapsed += OnTimerTick;
        _gameTimer.AutoReset = false; // Trigger once per tick, we manual restart to prevent overlapping ticks
        _gameTimer.Start();
    }

    private void OnTimerTick(object? sender, ElapsedEventArgs e)
    {
        // Calculate AI search step
        int move = (_currentPlayer == Player.Red ? _ai1! : _ai2!).GetBestMove(_board, _currentPlayer);

        if (move == -1 || !_board.MakeMove(move, _currentPlayer))
        {
            _status = $"{(_currentPlayer == Player.Red ? "Red" : "Yellow")} forfeited!";
            CleanupMatch();
            return;
        }

        GameState state = _board.CheckGameState();
        if (state != GameState.Ongoing)
        {
            if (state == GameState.Draw)
                _status = "Draw Game!";
            else
                _status = $"{(_currentPlayer == Player.Red ? "Red" : "Yellow")} Wins!";
            CleanupMatch();
            return;
        }

        // Swap turns
        _currentPlayer = _currentPlayer == Player.Red ? Player.Yellow : Player.Red;
        _status = $"{(_currentPlayer == Player.Red ? "Red" : "Yellow")}'s turn...";

        // Notify Blazor to rerender HTML on the browser
        InvokeAsync(StateHasChanged);

        // Restart timer with current delay
        if (_gameTimer != null)
        {
            _gameTimer.Interval = _delayMs;
            _gameTimer.Start();
        }
    }

    private void CleanupMatch()
    {
        _gameTimer?.Stop();
        _gameTimer?.Dispose();
        _gameTimer = null;
        _isPlaying = false;
        
        // Notify Blazor to render the final state
        InvokeAsync(StateHasChanged);
    }

    private void ResetMatch()
    {
        CleanupMatch();
        _board = new Board();
        _status = "Select players and start";
        StateHasChanged();
    }
    #endregion
}
